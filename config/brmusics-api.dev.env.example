# brmusics-api — desenvolvimento (profile: dev).
#   cp config/brmusics-api.dev.env.example config/brmusics-api.dev.env

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Banco de dados ---
DB_URL=jdbc:postgresql://181.215.134.218:5432/brmusics
DB_USERNAME=postgres
DB_PASSWORD=COLOCAR_SENHA_BD

# --- Aplicação ---
APP_API_INTERNAL_URL=http://localhost:8081
# Origem CORS do brmusics-frontend (navegador).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3002

# --- Storage / MinIO ---
STORAGE_TYPE=local
MINIO_URL=
MINIO_BUCKET=spscloud
MINIO_DEFAULT_FOLDER=sistemas/brmusics/
MINIO_ACCESS_NAME=
MINIO_ACCESS_SECRET=
BRMUSICS_STORAGE_LOCAL_ANEXOS=${user.home}/brmusics/anexos

# --- Servidor ---
SERVER_PORT=8081
AUTH_COOKIE_SECURE=false
SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- JWT próprio (HS256; mínimo 32 caracteres) ---
JWT_SECRET=altere-este-segredo-local-com-32ch
JWT_ISSUER=brmusics-api
JWT_EXPIRATION_SECONDS=28800

# --- WhatsApp Business / Cloud API ---
# Dev: provider fake (não envia mensagem real).
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=fake
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_MAX_TENTATIVAS=3
WHATSAPP_RETRY_INTERVAL_SECONDS=60
WHATSAPP_POLL_INTERVAL_MS=5000
WHATSAPP_STUCK_PROCESSING_SECONDS=300
WHATSAPP_BATCH_SIZE=20
