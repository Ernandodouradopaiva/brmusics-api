# Produção (profile: prod)

# --- Spring ---
# Profile Spring (dev|homolog|prod).
SPRING_PROFILES_ACTIVE=dev

# --- Banco de dados ---
# URL JDBC do PostgreSQL.
DB_URL=jdbc:postgresql://host.docker.internal:15432/projetoa
# Usuário do banco.
DB_USERNAME=postgres
# Senha do banco (vazia neste servidor).
DB_PASSWORD=

# --- Aplicação ---
# URL interna desta API (bootstrap).
APP_API_INTERNAL_URL=http://projetoA-api:8081
# Origins CORS permitidas (vírgula).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3002

# --- JWT próprio (HS256; mínimo 32 caracteres) ---
JWT_SECRET=altere-este-segredo-local-com-32ch
JWT_ISSUER=projetoA-api
JWT_EXPIRATION_SECONDS=28800
# --- Storage / MinIO ---
# Tipo de storage: minio|local.
STORAGE_TYPE=local
# Endpoint MinIO/S3 (vazio força storage local).
MINIO_URL=
# Bucket de objetos.
MINIO_BUCKET=spscloud
# Prefixo/pasta no bucket.
MINIO_DEFAULT_FOLDER=sistemas/projetoA/
# Access key MinIO.
MINIO_ACCESS_NAME=COLOCAR_ACCESS_KEY
# Secret key MinIO.
MINIO_ACCESS_SECRET=COLOCAR_SECRET_KEY
# Pasta local de anexos (só storage local).
PROJETO_A_STORAGE_LOCAL_ANEXOS=/opt/projetoA/anexos

# --- Servidor e segurança ---
# Porta HTTP da API.
SERVER_PORT=8081
# Flag Secure do cookie (true em HTTPS/prod).
AUTH_COOKIE_SECURE=false
# Habilita Swagger UI em /docs.
SPRINGDOC_SWAGGER_UI_ENABLED=false
