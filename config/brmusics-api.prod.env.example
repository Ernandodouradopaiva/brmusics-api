# brmusics-api — produção.
#   cp config/brmusics-api.prod.env.example config/brmusics-api.prod.env
#
# Kubernetes: ConfigMap + Secret.
# Ingress do host → brmusics-frontend (nunca brmusics-api).
# --- Spring ---
SPRING_PROFILES_ACTIVE=prod

# --- Banco de dados ---
DB_URL=jdbc:postgresql://181.215.134.218:5432/brmusics
DB_USERNAME=postgres
DB_PASSWORD=COLOCAR_SENHA_BD

# --- Aplicação ---
APP_API_INTERNAL_URL=http://brmusics-api:8081
# Origem CORS do brmusics-frontend.
APP_CORS_ALLOWED_ORIGINS=https://SEU_DOMINIO_BRMUSICS

# --- JWT próprio (HS256; mínimo 32 caracteres) ---
JWT_SECRET=COLOCAR_JWT_SECRET_COM_NO_MINIMO_32_CARACTERES
JWT_ISSUER=brmusics-api
JWT_EXPIRATION_SECONDS=28800

# --- Storage / MinIO ---
STORAGE_TYPE=minio
MINIO_URL=https://s3-golden.goldencloud.tech
MINIO_BUCKET=spscloud
MINIO_DEFAULT_FOLDER=sistemas/brmusics/
MINIO_ACCESS_NAME=COLOCAR_ACCESS_KEY
MINIO_ACCESS_SECRET=COLOCAR_SECRET_KEY
BRMUSICS_STORAGE_LOCAL_ANEXOS=/opt/brmusics/anexos

# --- Servidor ---
SERVER_PORT=8081
AUTH_COOKIE_SECURE=true
SPRINGDOC_SWAGGER_UI_ENABLED=false

# --- WhatsApp Business / Cloud API ---
# Produção: provider cloud. Segredos somente em Secret K8s.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_MAX_TENTATIVAS=3
WHATSAPP_RETRY_INTERVAL_SECONDS=60
WHATSAPP_POLL_INTERVAL_MS=5000
WHATSAPP_STUCK_PROCESSING_SECONDS=300
WHATSAPP_BATCH_SIZE=20
